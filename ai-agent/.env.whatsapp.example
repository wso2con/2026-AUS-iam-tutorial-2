# ai-agent/.env.whatsapp.example - template for the WhatsApp transport for the WhatsApp transport (port 8792).
#
# scripts/ai-agent-whatsapp.sh sources this with `set -a`, so every key here is
# exported into the agent process. It never touches ai-agent/.env, which keeps
# serving the web chat on 8791 with the shared root-org agent.
#
# Restore it with scripts/restore-envs.sh, from
# env-backups/ai-agent-whatsapp-env.txt.
#
# QUOTING: single quotes, always. The agent secret and the Meta token contain
# $ % @ # !, which the shell would otherwise expand or treat as a comment.

# --- Demo organization ------------------------------------------------------
# The sub-org this instance serves, and the handset that maps to it. Changing
# the org means changing the agent and the application below too: an agent
# created in one sub-org cannot sign in to another.
DEMO_ORG_ID='<sub-organization id>'
DEMO_PHONE='<demo handset, digits only>'
ASGARDEO_TENANT='wayfinderenterprise'

# --- Agent identity, native to DEMO_ORG_ID ----------------------------------
# Not shared down from the root org. Holds the WA-Assistant application role.
AGENT_ID='<agent id created inside DEMO_ORG_ID>'
AGENT_SECRET='<agent secret>'

# --- Application owned by DEMO_ORG_ID ---------------------------------------
# Must issue JWT access tokens under the ROOT issuer. mcp/server.ts builds one
# key set from the root /oauth2/jwks, which publishes only the tenant key, so an
# app issuing under the sub-org issuer (signed with that org's own key) is
# rejected. Public client, hence the empty secret.
CLIENT_ID='<client id of the sub-org application>'
CLIENT_SECRET=''

# There is no organization_switch on this path, so the API scopes have to be
# requested on the agent's own sign-in rather than picked up on an exchange.
AGENT_SIGN_IN_SCOPES='mcp:view_travel_policy'

# Leave this commented out. The agent reads the organization's own discovery
# document, which states the correct issuer, so nothing needs pinning here. Set it
# only for an application configured to issue under the organization-qualified
# issuer (https://api.asgardeo.io/t/<tenant>/o/<org-id>/oauth2/token), which
# discovery does not report because it is a per-application setting - and note
# mcp/server.ts cannot verify such a token, because the root /oauth2/jwks does not
# publish that organization's signing key.
# ASGARDEO_ISSUER=''

# --- Callback URLs ----------------------------------------------------------
# Both must be registered as Authorized Redirect URLs on CLIENT_ID above, or
# startup fails with "invalid_callback - callback.not.match".
REDIRECT_URI='http://localhost:8791'
# The user taps the authorize link on their phone, so this must be publicly
# reachable. Use http://localhost:8791/obo/callback for local-only testing.
OBO_REDIRECT_URI='https://<your public tunnel>/obo/callback'

# --- WhatsApp channel -------------------------------------------------------
# Setting WHATSAPP_PHONE_NUMBER_ID is what enables the /whatsapp/webhook routes.
WHATSAPP_PHONE_NUMBER_ID='<Meta > WhatsApp > API Setup>'
# Must match the Verify Token in Meta > WhatsApp > Configuration, or Meta's
# webhook handshake returns 403 and the subscription breaks.
WHATSAPP_VERIFY_TOKEN='<any random string, also set in Meta>'
WHATSAPP_TOKEN='<Meta access token>'
WHATSAPP_APP_SECRET='<Meta app secret>'
# Leave this true until a permanent Meta System User token is in place.
WHATSAPP_DRY_RUN='true'
